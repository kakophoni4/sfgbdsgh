# desktop | android | off
USE_OFFICIAL_API=desktop
TELEGRAM_PHONE=+79001234567

# Только если USE_OFFICIAL_API=off
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=

# Обогащение: пауза ~2.5–3.5с; при капче поднять до 10/5
# С прокси можно 1.5–2.5; без прокси лучше 4–5 (иначе капча)
ENRICH_PAUSE=2
ENRICH_JITTER=1
ENRICH_LIMIT=40
HISTORY_LIMIT=400

# Прокси ТОЛЬКО для Companium и Checko (не для БФО/ЕГРЮЛ)
# Список asocks (whitelist по IP сервера), обновляется сам:
# ENRICH_PROXY_LIST_URL=https://asocks-list.org/whitelist/XXXX.txt
# ENRICH_PROXY_LIST_TTL=900
# ENRICH_PROXY_TRIES=8
# Либо один прокси:
# ENRICH_PROXY=http://user:pass@host:443

# Google Sheets (расшарить таблицу на client_email из JSON как Редактор)
# GOOGLE_SHEETS_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON=C:\firmy\secrets\gsheets.json
